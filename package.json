{
  "name": "opencode-classifier-plugin",
  "version": "0.1.0",
  "description": "Jev-powered Auto Mode, selectable model router, agent/skill routing, and context filtering for OpenCode 1.18.x.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.ts",
    "./config": "./src/config.ts",
    "./types": "./src/types.ts"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE",
    "opencode.example.json"
  ],
  "keywords": [
    "opencode",
    "opencode-plugin",
    "jev",
    "system-one",
    "classifier",
    "model-router",
    "autopilot",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run check && npm run pack:check"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.32",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
