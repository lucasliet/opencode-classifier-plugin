{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    [
      "opencode-classifier-plugin",
      {
        "decision": {
          "endpoint": "https://opencode.ai/zen/v1/systemone",
          "model": "jev-1.13-free",
          "apiKeyEnv": "OPENCODE_API_KEY",
          "requireAuth": true,
          "timeoutMs": 8000,
          "retries": 1
        },
        "routing": {
          "enabled": true,
          "models": {
            "enabled": true
          },
          "agents": {
            "enabled": false,
            "minimumProbability": 0.85,
            "byDomain": {
              "frontend": "frontend",
              "backend": "backend",
              "database": "database",
              "security": "security"
            }
          }
        },
        "autoMode": {
          "enabled": true,
          "onError": "ask",
          "commandRules": {
            "ask": [
              "git push *",
              "npm publish"
            ],
            "deny": [
              "git push --force *"
            ]
          },
          "allowReversibleProjectChanges": true,
          "denyHighRisk": false,
          "thresholds": {
            "autoAllow": 0.8,
            "projectChange": 0.6,
            "reversibleAllow": 0.88,
            "riskAsk": 0.45,
            "deny": 0.65
          }
        },
        "context": {
          "enabled": true,
          "toolOutput": {
            "enabled": true,
            "minChars": 12000,
            "chunkChars": 2500,
            "minimumCandidates": 6,
            "maxCandidates": 24,
            "maxBatches": 4,
            "relevantAt": 0.52
          },
          "capabilities": {
            "enabled": true,
            "relevantAt": 0.4,
            "alwaysInclude": {
              "skills": [],
              "namespaces": ["opencode"]
            }
          }
        },
        "privacy": {
          "maxStateChars": 24000,
          "maxPromptChars": 8000,
          "maxEvidenceChars": 12000,
          "maxResourceChars": 4000,
          "includePermissionMetadata": false
        }
      }
    ]
  ]
}
